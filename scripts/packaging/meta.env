# Package identity + metadata consumed by scripts/pack-deb.sh.
# PKG_VERSION is overwritten by CI (commit hash / release tag); keep a sane default.
PKG_NAME="raspyjack"
PKG_VERSION="0.1.1"
PKG_REVISION="raspyjack1"
PKG_DESC="RaspyJack offensive security toolkit for CardputerZero"

# Debian Maintainer. The store validator REQUIRES this to be the submitter's
# real identity with a GitHub-verified email (or <login>@users.noreply.github.com).
# A placeholder/M5Stack/invalid email is auto-rejected.
APP_MAINTAINER="7h30th3r0n3 <75809682+7h30th3r0n3@users.noreply.github.com>"

# Runtime dependencies pulled by apt at install time. Kept to a LEAN core so the
# CardputerZero store's package-transaction timeout (M5APPSTORE_PACKAGE_TIMEOUT)
# is not exceeded on a fresh install: the full dependency set (with apt pulling
# Recommends) was ~250 packages and took >8 min on the device, so the store
# SIGTERM'd apt mid-transaction and rolled the app back. The heavy/optional tools
# (SDR stack, firmware blobs, tshark/ettercap, games, media, php, etc.) are now
# installed AFTER the package install by scripts/provision.sh, with
# --no-install-recommends and outside the store timeout. Keep this list minimal:
# only what the UI needs to boot and core payloads need not to crash on launch.
# 'sudo' is required by the launcher wrapper.
PKG_DEPENDS="sudo, python3, python3-pip, python3-dev, python3-scapy, python3-netifaces, python3-pyudev, python3-serial, python3-smbus, python3-rpi.gpio, python3-spidev, python3-pil, python3-qrcode, python3-numpy, python3-setuptools, python3-cryptography, python3-requests, python3-websockets, python3-evdev, python3-bluez, bluez, fonts-dejavu-core, fonts-font-awesome, wget, nmap, ncat, tcpdump, arp-scan, procps, aircrack-ng, wireless-tools, wpasupplicant, iw, hostapd, dnsmasq-base, sshpass, bridge-utils, ebtables, git, i2c-tools, unzip, alsa-utils, pipewire-alsa, caddy"

# APPLaunch .desktop fields.
APP_NAME="RaspyJack"
APP_EXEC="/usr/share/APPLaunch/apps/raspyjack/run-raspyjack.sh"
APP_TERMINAL=false
APP_ICON="share/images/raspyjack.png"
