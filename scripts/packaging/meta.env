# Package identity + metadata consumed by scripts/pack-deb.sh.
# PKG_VERSION is overwritten by CI (commit hash / release tag); keep a sane default.
PKG_NAME="raspyjack"
PKG_VERSION="0.dev"
PKG_REVISION="raspyjack1"
PKG_DESC="RaspyJack offensive security toolkit for CardputerZero"

# Debian Maintainer. The store validator REQUIRES this to be the submitter's
# real identity with a GitHub-verified email (or <login>@users.noreply.github.com).
# A placeholder/M5Stack/invalid email is auto-rejected.
APP_MAINTAINER="7h30th3r0n3 <75809682+7h30th3r0n3@users.noreply.github.com>"

# Runtime dependencies pulled by apt at install time (pwnagotchi model: heavy
# tooling declared here, not bundled). 'sudo' is required by the launcher wrapper.
PKG_DEPENDS="sudo, python3, python3-pip, python3-dev, python3-scapy, python3-netifaces, python3-pyudev, python3-serial, python3-smbus, python3-rpi.gpio, python3-spidev, python3-pil, python3-qrcode, python3-numpy, python3-setuptools, python3-cryptography, python3-requests, python3-websockets, python3-evdev, libglib2.0-dev, python3-bluez, bluez, fonts-dejavu-core, fonts-font-awesome, wget, nmap, ncat, tcpdump, tshark, arp-scan, dsniff, ettercap-text-only, php-cli, procps, aircrack-ng, wireless-tools, wpasupplicant, iw, hostapd, dnsmasq-base, sshpass, bridge-utils, john, autossh, reaver, ebtables, firmware-realtek, firmware-atheros, firmware-misc-nonfree, git, i2c-tools, rtl-sdr, alsa-utils, pipewire-alsa, caddy, unzip, ffmpeg, yt-dlp, gpsd, gpsd-clients, mpv, rtl-433, bluez-alsa-utils, chocolate-doom, freedoom, xvfb, xdotool"

# APPLaunch .desktop fields.
APP_NAME="RaspyJack"
APP_EXEC="/usr/share/APPLaunch/apps/raspyjack/run-raspyjack.sh"
APP_TERMINAL=false
APP_ICON="share/images/raspyjack.png"
